# Backend
APP_DATA_DIR=./data
APP_MAX_UPLOAD_MB=20
APP_MAX_PAGES=500
APP_MAX_TEXT_CHARS=2000000
APP_LIBREOFFICE_PATH=

# OpenAI-compatible model configuration. Never commit a real key.
MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=https://jiniu.ai/v1
MODEL_API_KEY=
MODEL_NAME=gpt-5.4
MODEL_BYPASS_PROXY=true
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_BATCH_CHARS=12000
MODEL_MAX_CONCURRENCY=1
